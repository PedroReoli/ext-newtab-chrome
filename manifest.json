{
  "manifest_version": 3,
  "name": "Nova Guia",
  "version": "58.0.0",
  "description": "Nova guia para organizar atalhos, grupos e automações de páginas.",
  "permissions": ["alarms", "storage", "tabs"],
  "background": { "service_worker": "background.js" },
  "chrome_url_overrides": { "newtab": "index.html" }
