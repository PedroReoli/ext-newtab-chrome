{
  "manifest_version": 3,
  "name": "ReoliTab",
  "version": "57.0.0",
  "description": "Sistema de Nova Guia ReoliTab com Painel Produtivo, Timer Pomodoro, Favoritos e Central de Notícias.",
  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "*://127.0.0.1/*",
    "*://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
